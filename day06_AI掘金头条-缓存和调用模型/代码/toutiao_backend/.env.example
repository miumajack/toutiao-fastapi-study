# 把本文件复制成 .env,然后填上你自己的密钥
# 阿里云百炼(通义千问)控制台可以申请:https://bailian.console.aliyun.com/

# 模型服务的密钥。留空的话 /api/ai/chat 会返回 503 并提示未配置
AI_API_KEY=

# 假模型开关:1=不调用真实模型,直接返回写死的假回复(用于前端联调)
# 填好 AI_API_KEY 后把它改成 0
AI_MOCK=0

# 接口地址。下面三个厂商任选一组,换厂商只改这两行
#
# 阿里云百炼(通义千问):
#   AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   AI_MODEL=qwen-plus
#
# DeepSeek:
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_MODEL=deepseek-chat
#
# 本地 Ollama:
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=qwen2.5:7b
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus

# 单次调用最多等多久(秒)
AI_TIMEOUT=30

# 最多带多少条历史消息给模型
AI_MAX_HISTORY=10

# 系统提示词,决定 AI 的角色
AI_SYSTEM_PROMPT=你是一个新闻资讯网站的 AI 助手,回答简洁准确,使用中文,不要编造新闻事实。
